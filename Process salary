import java.util.function.Function;

public class Main {
    static void processSalary(double salaries, Function<Double, Double> operation) {
        double result = operation.apply(salaries);
        System.out.println("update salary " + result);
    }

    public static void main(String[] args) {
        double salary = 50000;
        processSalary(salary,s->s+(s*10/100));
        processSalary(salary,s->s+5000);
        processSalary(salary,s->s-(s*10/100));
    }
}
