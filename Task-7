import java.util.*;
import java.util.function.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        String c=sc.next();
        IntPredicate p=c.equals("even")?x->x%2==0:x->x%2!=0;
        int s=0;
        while(n>0){
            int d=n%10;
            if(p.test(d)) s+=d;
            n/=10;
        }
        System.out.println(s);
    }
}
