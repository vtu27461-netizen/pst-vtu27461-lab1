import java.util.*;
public class Main {
    static boolean check(int n){
        int t=n,r=0;
        while(t>0){
            r=r*10+t%10;
            t/=10;
        }
        return n==r;
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        System.out.println(Main.check(sc.nextInt()));
    }
}
