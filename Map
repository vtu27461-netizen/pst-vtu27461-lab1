import java.util.Arrays;
import java.util.List;
public class Map{
    static void process(List<Integer> numbers,
                        java.util.function.Function<Integer, Integer> operation) {
        numbers.stream()
               .map(operation)
               .forEach(System.out::println);
    }
    public static void main(String[] args) {
        List<Integer> numbers = Arrays.asList(5,32,6,12);
        process(numbers,n -> n-7);
        process(numbers,n -> n/2);
    }
}
